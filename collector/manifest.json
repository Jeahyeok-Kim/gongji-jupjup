{
  "manifest_version": 3,
  "name": "공지 줍줍 수집기",
  "version": "1.5.0",
  "description": "건국대 글로컬캠퍼스 공지와 KIS/에브리타임 강의 시간표 및 강의계획서 상세(담당 교수명·연락처·평가비율 포함)를 브라우저에서 모아 웹 앱으로 동기화합니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://www.kku.ac.kr/*",
    "https://int.kku.ac.kr/*",
    "https://ids.kku.ac.kr/*",
    "https://rule.konkuk.ac.kr/*",
    "https://im.kku.ac.kr/*",
    "https://kis.kku.ac.kr/*",
    "https://everytime.kr/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.github.io/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kku.ac.kr/*",
        "https://int.kku.ac.kr/*",
        "https://ids.kku.ac.kr/*"
      ],
      "js": [
        "config.js",
        "crawler.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://im.kku.ac.kr/*"
      ],
      "js": [
        "config.js",
        "im-crawler.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kku.ac.kr/*",
        "https://rule.konkuk.ac.kr/*"
      ],
      "js": [
        "config.js",
        "reference.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kis.kku.ac.kr/*"
      ],
      "js": [
        "kis-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://kis.kku.ac.kr/*"
      ],
      "js": [
        "config.js",
        "kis-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://everytime.kr/*"
      ],
      "js": [
        "config.js",
        "everytime-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "공지 줍줍 수집기",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
